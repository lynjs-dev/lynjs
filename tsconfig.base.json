{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "ESNext.Decorators"],

    "module": "Preserve",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": true,

    "jsx": "preserve",

    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,

    "resolveJsonModule": true,

    "noEmit": true
  },
  "include": ["src"]
}
