{
  "extends": "./tsconfig.base.json",
  "include": ["src/**/*.ts", "src/**/*.tsx", "types/jsx.d.ts", "test/**/*.ts", "test/**/*.tsx"],
  "exclude": ["dist", "node_modules"],
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "lynjs",
    "rootDir": "./src",
    "baseUrl": "./src",
    "outDir": "./types"
  }
}
