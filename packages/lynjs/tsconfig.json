{
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*.ts", "src/**/*.tsx", "types/**/*.ts", "test/**/*.ts", "test/**/*.tsx"],
  "exclude": ["dist", "node_modules"],
  "compilerOptions": {
    "typeRoots": ["./node_modules/@types"],
    "jsx": "preserve",
    "jsxImportSource": "lynjs",
    "rootDir": "./src",
    "baseUrl": "./src",
    "outDir": "./dist"
  }
}
