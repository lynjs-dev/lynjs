{
  "extends": "./tsconfig.base.json",
  "include": ["src/**/*.ts", "src/**/*.tsx", "types/**/*.ts", "test/**/*.ts", "test/**/*.tsx"],
  "exclude": ["**/*.test.ts", "**/*.test.tsx", "test", "dist", "node_modules"],
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "lynjs",
    "rootDir": "./src",
    "baseUrl": "./src",
    "outDir": "./dist"
  }
}
