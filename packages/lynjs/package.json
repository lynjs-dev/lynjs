{
  "name": "lynjs",
  "version": "0.2.0-next.5",
  "description": "A declarative JavaScript library for building fast, lightweight web components",
  "type": "module",
  "license": "BSD-3-Clause",
  "packageManager": "pnpm@10.4.0",
  "engines": {
    "node": ">=18",
    "pnpm": ">=9.0.0"
  },
  "files": [
    "dist",
    "types",
    "README.md"
  ],
  "module": "dist/index.js",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.ts"
    },
    "./package.json": "./package.json",
    "./lyn-element": {
      "types": "./dist/lyn-element.d.ts",
      "default": "./dist/lyn-element.js"
    },
    "./reactive": {
      "types": "./dist/reactive.d.ts",
      "default": "./dist/reactive.js"
    },
    "./dom": {
      "types": "./dist/lyn-element.d.ts",
      "default": "./dist/dom/index.js"
    },
    "./jsx-runtime": {
      "types": "./types/jsx.d.ts"
    }
  },
  "keywords": [
    "lyn",
    "lynjs",
    "ui",
    "reactive",
    "components",
    "performance",
    "jsx"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rollup -c && npx tsc -p tsconfig.build.json --emitDeclarationOnly",
    "test": "NODE_ENV=test npx vitest run --browser.headless",
    "test:prepare": "npx playwright install",
    "test:watch": "NODE_ENV=test npx vitest --browser.headless --watch",
    "test:browser": "NODE_ENV=test npx vitest"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.28.5",
    "@rollup/plugin-babel": "^6.1.0",
    "@rollup/plugin-commonjs": "^28.0.9",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@vitest/browser": "^3.2.4",
    "babel-plugin-transform-rename-import": "^2.3.0",
    "babel-preset-lynjs": "workspace:^",
    "jsdom": "^27.1.0",
    "playwright": "^1.56.1",
    "rollup": "^4.52.5",
    "rollup-plugin-esbuild": "^6.2.1",
    "rollup-plugin-tsconfig-paths": "^1.5.2",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "dom-expressions": "^0.40.3"
  }
}
