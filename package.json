{
  "name": "lynjs-monorepo",
  "version": "0.2.0-next.6",
  "description": "monorepo for lynjs",
  "private": true,
  "type": "module",
  "license": "BSD-3-Clause",
  "packageManager": "pnpm@10.4.0",
  "engines": {
    "pnpm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/[GITHUB_USER_NAME]/[REPOSITORY_NAME].git"
  },
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    }
  },
  "sideEffects": false,
  "scripts": {
    "prepare": "husky",
    "clean": "git clean -fdX -e node_modules",
    "test": "pnpm --prefix packages/lynjs run test",
    "build": "pnpm -r --filter=./packages/* build",
    "__verify:pack": "npm pack --dry-run",
    "__prepublishOnly": "npm run verify:pack",
    "__pack:preset": "npm pack -w packages/babel-preset-lynjs",
    "__publish:preset": "npm publish -w packages/babel-preset-lynjs --access public",
    "__version:preset": "npm version patch -w packages/babel-preset-lynjs",
    "release": "semantic-release",
    "lint": "eslint . --report-unused-disable-directives --cache",
    "lint:fix": "pnpm lint -- --fix --max-warnings=0",
    "format": "prettier . --check --cache",
    "format:fix": "prettier . --write --cache",
    "docs": "pnpm --prefix docs run start",
    "docs:build": "pnpm --prefix docs run build"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.39.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.6",
    "@semantic-release/npm": "^12.0.2",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@testing-library/dom": "^10.4.1",
    "babel-preset-lynjs": "workspace:^",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "lynjs": "workspace:^",
    "prettier": "^3.6.2",
    "semantic-release": "^24.2.9",
    "typescript-eslint": "^8.46.2",
    "vite-plugin-lynjs": "workspace:^"
  },
  "lint-staged": {
    "*.{ts,tsx,js,cjs,mjs}": [
      "npm run lint:fix"
    ],
    "*.{json,yml,yaml,css,scss,html,md}": [
      "npm run format:fix"
    ]
  }
}
