{
  "name": "lynjs",
  "version": "0.0.2-next.2",
  "private": false,
  "license": "BSD-3-Clause",
  "type": "module",
  "files": [
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "__comment_publish__": "",
    "verify:pack": "npm pack --dry-run",
    "prepublishOnly": "npm run verify:pack",
    "__comment_eslint__": "",
    "lint": "eslint --ext .ts,.tsx,.js,.cjs --report-unused-disable-directives --cache",
    "lint:all": "eslint . --ext .ts,.tsx,.js,.cjs --report-unused-disable-directives --cache",
    "lint:fix": "npm run lint -- --fix --max-warnings=0",
    "format": "prettier . --check --cache",
    "format:fix": "prettier . --write --cache",
    "lint:ws": "npm run lint -ws --if-present",
    "format:ws": "npm run format -ws --if-present",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.5.4",
    "semantic-release": "^25.0.9",
    "typescript": "npm:@typescript/typescript6@^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,cjs,mjs}": [
      "npm run lint:fix"
    ],
    "*.{json,yml,yaml,css,scss,html,md}": [
      "npm run format:fix"
    ]
  }
}
